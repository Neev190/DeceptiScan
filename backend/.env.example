# DeceptiScan Backend Configuration

# Flask
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL=postgresql://deceptiscan:password@localhost:5432/deceptiscan

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600

# API Configuration (16MB request payload limit)
MAX_CONTENT_LENGTH=16777216

# ML Service (for future use)
ML_SERVICE_URL=http://localhost:5001

# Cloudinary (Profile Picture Uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret